% ========================================
% ugr-thesis -- Plantilla de Tesis de la UGR
% ========================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ugrthesis}[2026/08/06 v0.2.0 Configuracion UGR]

%% Plantilla LaTeX para Trabajos Fin de Grado/Máster de la Universidad de Granada
%% Autor: https://github.com/L-51
%% Licencia: MIT

% ========================================
% Idiomas y Fuentes
% ========================================
\RequirePackage{iftex}
% En función de que recipe se elija
\ifPDFTeX
    \RequirePackage[T1]{fontenc}
    \RequirePackage[utf8]{inputenc}
\else
    \RequirePackage{fontspec}
\fi
\RequirePackage[spanish,es-tabla]{babel} % Idioma español

% ========================================
% Márgenes y Formato
% ========================================
\setlength{\headheight}{43pt} % Evitar warning de fancyhdr
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
% Estilo para el Frontmatter (Números romanos en el centro, sin línea abajo)
\fancypagestyle{frontstyle}{
    \fancyhf{}
    \fancyhead[LE,LO]{\includegraphics[height=1cm]{\ugrthesis@logoUGR}\quad\textbf{\ugr}} % Arriba Izquierda: UGR
    \fancyhead[RE,RO]{\textit{\ugrthesis@titulo}} % Arriba Derecha: Título
    \fancyfoot[C]{\thepage} % Abajo Centro: Número de página
    \renewcommand{\headrulewidth}{0.4pt} % Línea arriba
    \renewcommand{\footrulewidth}{0pt}   % Sin línea abajo
}
% Estilo para el Mainmatter (Números arábigos a la derecha, con línea abajo)
\fancypagestyle{mainstyle}{
    \fancyhf{}
    \fancyhead[LE,LO]{\includegraphics[height=1cm]{\ugrthesis@logoUGR}\quad\textbf{\ugr}}
    \fancyhead[RE,RO]{\textit{\ugrthesis@titulo}}
    \fancyfoot[RO,LE]{Página \thepage{} de \pageref*{LastPage}}
    \renewcommand{\headrulewidth}{0.4pt} % Línea arriba
    \renewcommand{\footrulewidth}{0.4pt} % Línea abajo
}
% Guardamos una copia de los comandos originales de LaTeX
\let\ugrthesis@frontmatter\frontmatter
\let\ugrthesis@mainmatter\mainmatter
\renewcommand{\frontmatter}{%
    \ugrthesis@frontmatter
    \pagestyle{frontstyle}%
    \fancypagestyle{plain}{\pagestyle{frontstyle}}%
}

\renewcommand{\mainmatter}{%
    \ugrthesis@mainmatter
    \pagestyle{mainstyle}%
    \fancypagestyle{plain}{\pagestyle{mainstyle}}%
}
\RequirePackage{parskip} % Espacio entre párrafos
% Evitar líneas "huérfanas"
\clubpenalty=10000
\widowpenalty=10000
\RequirePackage[a4paper,top=3cm,bottom=3cm,inner=3.5cm,outer=2.5cm]{geometry}
\RequirePackage{setspace}
\onehalfspacing % Interlineado 1.5 en todo el documento
\RequirePackage{emptypage}

% ========================================
% Matemáticas
% ========================================
\RequirePackage{amsmath, amssymb, amsthm}
% Ajuste para teoremas, proposición y definición
\theoremstyle{plain}
\newtheorem{teorema}{Teorema}[chapter]
\newtheorem{proposicion}[teorema]{Proposición}
\newtheorem{lema}[teorema]{Lema}
\theoremstyle{definition}
\newtheorem{definicion}{Definición}[chapter]
\theoremstyle{remark}
\newtheorem{nota}{Nota}[chapter]

% ========================================
% Gráfica, Tikz y Colores
% ========================================
\RequirePackage{graphicx}
% Definir dónde se guardan las imágenes por defecto
\graphicspath{{figures/}{figures/logos/}}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{positioning}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}  % Use PGFPlots version 1.18, disables backward compatibility warnings
\RequirePackage{float} % Posicionamiento de elementos flotantes

% Colores corporativos UGR (Rojo Granate)
\definecolor{UGRrojo}{RGB}{206,0,55}

% ========================================
% Listas y Código
% ========================================
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e} % Pseudocódigo
% Traducir a español
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Índice de Códigos}
% Configuración del listings
\lstset{
basicstyle=\ttfamily\normalsize,
keywordstyle=\color{blue}\bfseries,
commentstyle=\color{green!60!black}\itshape,
stringstyle=\color{orange},
numbers=left,
numberstyle=\tiny\color{gray},
stepnumber=1,
breaklines=true,
frame=single,
showstringspaces=false,
captionpos=b,
extendedchars=true,
literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
{ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1
{Ú}{{\'U}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {Ü}{{\"U}}1 {¿}{{\textquestiondown}}1 {¡}{{\textexclamdown}}1
}

% ========================================
% Bibliografía y Citaciones
% ========================================
\RequirePackage{csquotes}
\RequirePackage[backend=biber,style=numeric]{biblatex}
\addbibresource{references.bib} % Apunta a tu archivo de bibliografía

% ========================================
% Hiperenlace
% ========================================
\RequirePackage[
    colorlinks=true,
    linkcolor=UGRrojo,
    urlcolor=UGRrojo,
    citecolor=UGRrojo
]{hyperref}

% ========================================
% Cargar definiciones
% ========================================

% Carga de macros y portadas
\InputIfFileExists{styles/ugrthesis.def}{}{
    \PackageError{ugrthesis}{No encuentro el archivo ugrthesis.def}{Vuelve a descargar la plantilla de GitHub}
}

\InputIfFileExists{styles/ugr-cover.def}{}{
    \PackageError{ugrthesis}{No encuentro el archivo ugr-cover.def}{Vuelve a descargar la plantilla de GitHub}
}

\InputIfFileExists{styles/ugr-statement.def}{}{
    \PackageError{ugrthesis}{No encuentro el archivo ugrthesis.def}{Vuelve a descargar la plantilla de GitHub}
}

% ========================================
% Inyectar metadatos al PDF
% ========================================
\AtBeginDocument{
    \hypersetup{
        pdftitle={\ugrthesis@titulo},
        pdfauthor={\ugrthesis@autor},
        pdfsubject={\ugrthesis@tipoDocumento - \ugrthesis@titulacion},
        pdfkeywords={\ugrthesis@keywords}
    }
}