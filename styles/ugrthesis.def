% ========================================
% Definiciones
% ========================================
\def\ugr{Universidad de Granada}
\def\ugrEN{University of Granada}
\def\ugrthesis@tipoDocumento{}
\def\ugrthesis@titulo{}
\def\ugrthesis@tituloEN{}

\def\ugrthesis@labelAutor{}
\def\ugrthesis@autor{}
\def\ugrthesis@dni{}
\def\ugrthesis@email{}

\def\ugrthesis@labelTutor{}
\def\ugrthesis@tutor{}
\def\ugrthesis@labelDepartamento{}
\def\ugrthesis@departamento{}
\def\ugrthesis@titulacion{}

\def\ugrthesis@centro{}
\def\ugrthesis@centroSec{}

\def\ugrthesis@fecha{}
\def\ugrthesis@curso{}

\def\ugrthesis@logoUGR{}
\def\ugrthesis@logoCentro{}
\def\ugrthesis@logoCentroSec{}

\def\ugrthesis@palabrasClave{}
\def\ugrthesis@keywords{}

% ========================================
% API Pública
% ========================================
% Datos del Documento
\newcommand{\tipoDocumento}[1]{\def\ugrthesis@tipoDocumento{#1}}
\newcommand{\titulo}[1]{\def\ugrthesis@titulo{#1}}
\newcommand{\tituloEN}[1]{\def\ugrthesis@tituloEN{#1}} % Para el abstract en inglés

% Datos del Autor
\newcommand{\autor}[2][Autor/a]{
    \def\ugrthesis@labelAutor{#1}
    \def\ugrthesis@autor{#2}
}
\newcommand{\dni}[1]{\def\ugrthesis@dni{#1}}
\newcommand{\email}[1]{\def\ugrthesis@email{#1}}

% Datos Académicos
\newcommand{\tutor}[2][Tutor/es]{
    \def\ugrthesis@labelTutor{#1}
    \def\ugrthesis@tutor{#2}
}
\newcommand{\departamento}[2][Departamento/s]{
    \def\ugrthesis@labelDepartamento{#1}
    \def\ugrthesis@departamento{#2}
}
\newcommand{\titulacion}[1]{\def\ugrthesis@titulacion{#1}}
\newcommand{\centro}[1]{\def\ugrthesis@centro{#1}}
\newcommand{\centroSec}[1]{\def\ugrthesis@centroSec{#1}}
\newcommand{\fecha}[1]{\def\ugrthesis@fecha{#1}}
\newcommand{\curso}[1]{\def\ugrthesis@curso{#1}}

% Logos de los Centros (Con soporte para Dobles Grados)
\newcommand{\logoUGR}[1]{\def\ugrthesis@logoUGR{#1}}
\newcommand{\logoCentro}[1]{\def\ugrthesis@logoCentro{#1}}
\newcommand{\logoCentroSec}[1]{\def\ugrthesis@logoCentroSec{#1}}

% Resumen / Abstract
\newcommand{\palabrasClave}[1]{\def\ugrthesis@palabrasClave{#1}}
\newcommand{\keywords}[1]{\def\ugrthesis@keywords{#1}}
