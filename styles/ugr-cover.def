\newcommand{\MakeCover}{
    \begin{titlepage}
        \newgeometry{left=2.5cm, right=2.5cm, top=1cm, bottom=2.5cm}
        \thispagestyle{empty}

        % Marca de agua del fondo y el rectángulo rojo de abajo
        \begin{tikzpicture}[remember picture, overlay]
            \node[
                opacity=0.08,
                inner sep=0pt,
                anchor=center,
                xshift=-1.2cm,
                yshift=-3.5cm
            ] at (current page.south east) {
                \includegraphics[width=2\paperwidth]{figures/logos/logo_UGR_watermark.png}
            };
            \fill[UGRrojo]
            (current page.south west)
            rectangle
            ([yshift=1cm]current page.south east);
        \end{tikzpicture}

        \begin{center}
            {\LARGE \textsc{\ugrtesis@tipoDocumento}} \\
            \vfill
            {\Large \textbf{\ugrtesis@titulacion}} \\
            \vfill
            {\LARGE \textup{\ugrtesis@curso}} \\
            \vfill
            \includegraphics[width=0.2\paperwidth]{\ugrtesis@logoUGR} \\
            \vfill
            {\huge \textbf{\ugr}} \\
            \vfill
            {\Huge \textbf{\ugrtesis@titulo}} \\
            \vfill
            {\Large \textbf{\ugrtesis@labelAutor:}} \\
            {\Large \upshape \ugrtesis@autor} \\
            \vfill
            {\Large \textbf{\ugrtesis@labelTutor:}} \\
            {\Large \upshape \ugrtesis@tutor} \\
            \vfill
            {\Large \textbf{\ugrtesis@labelDepartamento:}} \\
            {\Large \upshape \ugrtesis@departamento} \\
            \vfill
            \ifx\ugrtesis@logoCentroSec\@empty
                % Un solo centro
                \includegraphics[height=1.4cm]{\ugrtesis@logoCentro} \\
                \vfill
                {\Large \textbf{\ugrtesis@centro}} \\
            \else
                % Doble titulación
                \begin{minipage}{0.49\textwidth}
                    \centering
                    \includegraphics[height=1.4cm]{\ugrtesis@logoCentro} \\
                    \vfill
                    {\Large \textbf{\ugrtesis@centro}}
                \end{minipage}%
                \vrule width 0.5pt%
                \begin{minipage}{0.49\textwidth}
                    \centering
                    \includegraphics[height=1.4cm]{\ugrtesis@logoCentroSec} \\
                    \vfill
                    {\Large \textbf{\ugrtesis@centroSec}}
                \end{minipage} \\
            \fi
            \vfill
            \rule{0.5cm}{0.5pt} \\
            \vfill
            {\Large \textup{\ugrtesis@fecha}}
        \end{center}
    \end{titlepage}
    \restoregeometry
}
