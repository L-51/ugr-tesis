% ========================================
% ugr-tesis -- Plantilla de Tesis de la UGR
% ========================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ugrtesis}[2026/08/06 v0.5.2 Configuracion UGR]

%% Plantilla LaTeX para Trabajos Fin de Grado/Máster de la Universidad de Granada
%% Autor: https://github.com/L-51
%% Licencia: MIT

% ========================================
% Declaración de opciones
% ========================================
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
    family=ugrtesis,
    prefix=ugrtesis@
}

% Márgenes del documento
\DeclareStringOption[3cm]{top}
\DeclareStringOption[3cm]{bottom}
\DeclareStringOption[3.5cm]{inner}
\DeclareStringOption[2.5cm]{outer}
\DeclareStringOption[onehalf]{spacing}
% Estilo de bibliografía, por defecto numeric para ciencias/info
\DeclareStringOption[numeric]{bibstyle}
% Estilo de lenguaje, por defecto español
\DeclareStringOption[spanish]{language}
% Fuente de las letras, por defecto, la fuente clásica de LaTex
\DeclareStringOption[default]{font}
% Opciones booleanas para cargar o no paquetes
\DeclareBoolOption[true]{math}
\DeclareBoolOption[true]{code}

\ProcessKeyvalOptions*

% ========================================
% Idiomas y Fuentes
% ========================================
\RequirePackage{iftex}
\RequirePackage{etoolbox}
% En función del motor se elija
\ifPDFTeX
    \RequirePackage[T1]{fontenc}
    \RequirePackage[utf8]{inputenc}
    \ifdefstring{\ugrtesis@font}{default}{}{
        \PackageWarning{ugrtesis}{
            El motor pdfLaTeX no soporta fuentes del sistema directamente. Por favor, cambia el compilador a XeLaTeX en Overleaf/VS Code para usar la fuente '\ugrtesis@font', o ignora este aviso para continuar con la fuente estandar.}
    }
\else
    \RequirePackage{fontspec}
    \ifdefstring{\ugrtesis@font}{default}{}{
        \setmainfont{\ugrtesis@font}
    }
\fi
\RequirePackage[\ugrtesis@language,es-tabla]{babel}

% ========================================
% Márgenes y Formato
% ========================================
\setlength{\headheight}{43pt} % Evitar warning de fancyhdr
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
% Estilo para el Frontmatter (Números romanos en el centro, sin línea abajo)
\fancypagestyle{frontstyle}{
    \fancyhf{}
    \fancyhead[LE,LO]{\includegraphics[height=1cm]{\ugrtesis@logoUGR}\quad\textbf{UGR}} % Arriba Izquierda: UGR
    \fancyhead[RE,RO]{\textit{\ugrtesis@titulo}} % Arriba Derecha: Título
    \fancyfoot[C]{\thepage} % Abajo Centro: Número de página
    \renewcommand{\headrulewidth}{0.4pt} % Línea arriba
    \renewcommand{\footrulewidth}{0pt}   % Sin línea abajo
}
% Estilo para el Mainmatter (Números arábigos a la derecha, con línea abajo)
\fancypagestyle{mainstyle}{
    \fancyhf{}
    \fancyhead[LE,LO]{\includegraphics[height=1cm]{\ugrtesis@logoUGR}\quad\textbf{UGR}}
    \fancyhead[RE,RO]{\textit{\ugrtesis@titulo}}
    \fancyfoot[RO,LE]{Página \thepage{} de \pageref*{LastPage}}
    \renewcommand{\headrulewidth}{0.4pt} % Línea arriba
    \renewcommand{\footrulewidth}{0.4pt} % Línea abajo
}

\let\ugrtesis@frontmatter\frontmatter
\let\ugrtesis@mainmatter\mainmatter
\renewcommand{\frontmatter}{%
    \ugrtesis@frontmatter
    \pagestyle{frontstyle}%
    \fancypagestyle{plain}{\pagestyle{frontstyle}}%
}

\renewcommand{\mainmatter}{%
    \ugrtesis@mainmatter
    \pagestyle{mainstyle}%
    \fancypagestyle{plain}{\pagestyle{mainstyle}}%
}
% Para cambiar el formato de los capítulos
\RequirePackage{titlesec}
\titleformat{\chapter}[hang]
{\Huge\bfseries}
{\thechapter.}
{20pt}
{\Huge\bfseries}
\titlespacing*{\chapter}{0pt}{-20pt}{30pt}

\RequirePackage{parskip} % Espacio entre párrafos
% Evitar líneas "huérfanas"
\clubpenalty=10000
\widowpenalty=10000
\RequirePackage[
    a4paper,
    top=\ugrtesis@top,
    bottom=\ugrtesis@bottom,
    inner=\ugrtesis@inner,
    outer=\ugrtesis@outer
]{geometry}
\RequirePackage{setspace}
\onehalfspacing % Interlineado 1.5 en todo el documento
\RequirePackage{emptypage}

% ========================================
% Matemáticas
% ========================================
\ifugrtesis@math
    \RequirePackage{amsmath, amssymb, amsthm}
    % Ajuste para teoremas, proposición y definición
    \theoremstyle{plain}
    \newtheorem{teorema}{Teorema}[chapter]
    \newtheorem{proposicion}[teorema]{Proposición}
    \newtheorem{lema}[teorema]{Lema}
    \theoremstyle{definition}
    \newtheorem{definicion}{Definición}[chapter]
    \theoremstyle{remark}
    \newtheorem{nota}{Nota}[chapter]
\fi

% ========================================
% Gráfica, Tikz y Colores
% ========================================
\RequirePackage{graphicx}
% Definir dónde se guardan las imágenes por defecto
\graphicspath{{figures/}{figures/logos/}}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{positioning}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}  % Use PGFPlots version 1.18, disables backward compatibility warnings
\RequirePackage{float} % Posicionamiento de elementos flotantes

% Colores corporativos UGR (Rojo Granate)
\definecolor{UGRrojo}{RGB}{206,0,55}

% ========================================
% Listas y Código
% ========================================
\RequirePackage{enumitem}
\ifugrtesis@code
    \RequirePackage{listings}
    \RequirePackage[ruled,vlined,linesnumbered]{algorithm2e} % Pseudocódigo
    % Traducir a español
    \renewcommand{\lstlistingname}{Código}
    \renewcommand{\lstlistlistingname}{Índice de Códigos}
    % Configuración del listings
    \lstset{
    basicstyle=\ttfamily\normalsize,
    keywordstyle=\color{blue}\bfseries,
    commentstyle=\color{green!60!black}\itshape,
    stringstyle=\color{orange},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    breaklines=true,
    frame=single,
    showstringspaces=false,
    captionpos=b,
    extendedchars=true,
    literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1
    {Ú}{{\'U}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {Ü}{{\"U}}1 {¿}{{\textquestiondown}}1 {¡}{{\textexclamdown}}1
    }
\fi

% ========================================
% Bibliografía y Citaciones
% ========================================
\RequirePackage{csquotes}
\RequirePackage[backend=biber, style=\ugrtesis@bibstyle]{biblatex}\addbibresource{references.bib} % Apunta a tu archivo de bibliografía

% ========================================
% Hiperenlace
% ========================================
\RequirePackage[
    colorlinks=true,
    linkcolor=UGRrojo,
    urlcolor=UGRrojo,
    citecolor=UGRrojo
]{hyperref}

% ========================================
% Cargar definiciones
% ========================================
\InputIfFileExists{styles/ugrtesis.def}{}{
    \PackageError{ugrtesis}{No encuentro el archivo ugrtesis.def}{Vuelve a descargar la plantilla de GitHub}
}

\InputIfFileExists{styles/ugr-cover.def}{}{
    \PackageError{ugrtesis}{No encuentro el archivo ugr-cover-modern.def}{Vuelve a descargar la plantilla de GitHub.}
}

\InputIfFileExists{styles/ugr-statement.def}{}{
    \PackageError{ugrtesis}{No encuentro el archivo ugr-statement.def}{Vuelve a descargar la plantilla de GitHub}
}

% ========================================
% Inyectar metadatos al PDF
% ========================================
\AtBeginDocument{
    \hypersetup{
        pdftitle={\ugrtesis@titulo},
        pdfauthor={\ugrtesis@autor},
        pdfsubject={\ugrtesis@tipoDocumento - \ugrtesis@titulacion},
        pdfkeywords={\ugrtesis@keywords}
    }
}
