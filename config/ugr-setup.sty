% ==============================================================================
% CONFIGURACIÓN BASE - UGR THESIS (CON LISTINGS)
% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ugr-setup}[2026/08/06 Configuracion UGR]

% 1. IDIOMA Y FUENTES (Adaptado para XeLaTeX)
% ------------------------------------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage[spanish,es-tabla]{babel} % Idioma español

% 2. MÁRGENES Y FORMATO DE PÁRRAFO
% ------------------------------------------------------------------------------
\RequirePackage{parskip} % Espacio entre párrafos (de tu config)
\RequirePackage[a4paper,top=3cm,bottom=3cm,inner=3.5cm,outer=2.5cm]{geometry}

% 3. MATEMÁTICAS (De tu config)
% ------------------------------------------------------------------------------
\RequirePackage{amsmath, amssymb, amsthm}

% 4. GRÁFICOS, TIKZ Y COLORES (De tu config)
% ------------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{positioning}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{float} % Posicionamiento de elementos flotantes

% Colores corporativos UGR (Rojo Granate)
\definecolor{UGRrojo}{RGB}{206,0,55}

% 5. LISTAS Y CÓDIGO FUENTE (Usando LISTINGS, sin dependencias de Python)
% ------------------------------------------------------------------------------
\RequirePackage{enumitem}
\RequirePackage{listings}
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Índice de Códigos}

\lstset{
    basicstyle=\ttfamily\small,
    frame=single,
    breaklines=true,
    numbers=left,
    numberstyle=\tiny\color{gray},
    keywordstyle=\color{blue}\bfseries,
    commentstyle=\color{OliveGreen}\itshape,
    stringstyle=\color{purple}
}

% 6. BIBLIOGRAFÍA (De tu config)
% ------------------------------------------------------------------------------
\RequirePackage{csquotes}
\RequirePackage[backend=biber,style=numeric]{biblatex}
\addbibresource{references.bib} % Apunta a tu archivo de bibliografía

% 7. MACROS PARA LA PORTADA (Necesario para el main.tex)
% ------------------------------------------------------------------------------
\newcommand{\tituloTFG}[1]{\def\@tituloTFG{#1}}
\newcommand{\autorTFG}[1]{\def\@autorTFG{#1}}
\newcommand{\tutorTFG}[1]{\def\@tutorTFG{#1}}
\newcommand{\departamentoTFG}[1]{\def\@departamentoTFG{#1}}
\newcommand{\titulacionTFG}[1]{\def\@titulacionTFG{#1}}
\newcommand{\convocatoriaTFG}[1]{\def\@convocatoriaTFG{#1}}

% 8. ENLACES E HIPERVÍNCULOS (De tu config, pero en rojo UGR)
% Siempre debe ser el último paquete
% ------------------------------------------------------------------------------
\RequirePackage[
    colorlinks=true,
    linkcolor=UGRrojo,
    urlcolor=UGRrojo,
    citecolor=UGRrojo
]{hyperref}
